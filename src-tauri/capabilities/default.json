{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "core:window:allow-set-theme",
    "core:window:allow-set-background-color",
    "core:webview:allow-set-webview-background-color"
  ]
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daytrace",
  "version": "0.3.0",
  "identifier": "dev.daytrace.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; frame-src http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Automatic timeline of your day",
    "copyright": "MIT. Based on Dayflow by Jerry Liu.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["daytrace"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDczNDdEOEVFNTcwOTdGODUKUldTRmZ3bFg3dGhIYzVJMWZoQ3RrS1krR09JQzhFMmxHSjJPa2lQMlZ3c1VGNmczcU5kT1ZPbmoK",
      "endpoints": ["https://github.com/ArneVDA-AP/daytrace/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
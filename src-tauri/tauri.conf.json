{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daytrace",
  "version": "0.2.1",
  "identifier": "dev.daytrace.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; frame-src http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Automatic timeline of your day",
    "copyright": "MIT. Based on Dayflow by Jerry Liu.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}